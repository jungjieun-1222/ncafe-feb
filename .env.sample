# === Ncafe Deployment Environment Variables ===
# This file is a template for the .env file.
# Replace values as needed for your production environment.

# 1) System / Basic
USER_ID=mochijj
# BACKEND_PORT=8012
FRONTEND_PORT=3012
AGENT_SERVER_PORT=8112


# 2) Database (PostgreSQL)
DB_PORT=5412
POSTGRES_DB=ncafedb
POSTGRES_PASSWORD=your_db_password_here
DB_DATA_PATH=./data

# 3) Backend Service
BACKEND_IMAGE=mochijj-backend:latest
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/ncafedb
SPRING_DATASOURCE_USERNAME=ncafe
SPRING_DATASOURCE_PASSWORD=your_db_password_here
JWT_SECRET=your_jwt_secret_here
# /home/[사용자명]/dist/ncafe/upload 와 같이 실제 경로를 지정해주세요.
UPLOAD_PATH=./dist/ncafe/upload

# 4) Frontend Service
FRONTEND_IMAGE=ncafe-frontend:latest
SESSION_SECRET=your_session_secret_here

# 5) Agent Server
AGENT_SERVER_IMAGE=agent-server:latest
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

